# Copia este archivo a `.env` y ajusta los valores.
#   Windows: Copy-Item .env.example .env    |    Linux/robot: cp .env.example .env

# ============================== SERVIDOR LLM ==================================
# Imagen base del motor (los overrides de compose ya la fijan; rara vez se toca)
#   CPU x86/arm64:  ghcr.io/ggml-org/llama.cpp:server
#   x86 + CUDA:     ghcr.io/ggml-org/llama.cpp:server-cuda12
#   Jetson (robot): dustynv/llama_cpp:r36.4.0
#LLM_BASE_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Puertos expuestos en el host: API (memoria+RAG) y llama-server crudo
API_PORT=8000
LLM_PORT=8080

# Modelo (ruta DENTRO del contenedor; el volumen ./models se monta en /models)
MODEL_PATH=/models/Qwen3-4B-Q4_K_M.gguf

# === Ventana de contexto amplia ===
# Qwen3-4B soporta 32768 tokens nativos. Con KV cache q8_0 + flash attention:
#   16384 ≈ 1,2 GB de KV   32768 ≈ 2,4 GB   (a sumar a los ~2,5 GB del modelo)
# Jetson Orin NX 16GB: 16384 va holgado junto a la pila del robot; 32768 cabe
# si vigilas tegrastats. GPU de escritorio: 32768 sin problema.
CTX_SIZE=16384

# IMPORTANTE: llama-server REPARTE el contexto entre slots paralelos.
# PARALLEL=1 -> toda la ventana es para la conversación activa (recomendado).
# PARALLEL=2 -> CTX/2 por slot; solo si necesitas llamadas concurrentes.
PARALLEL=1

# Threads de CPU (deja ~2 cores libres para el sistema; Orin NX tiene 8)
CPU_THREADS=6

# Capas offloadadas a GPU: 0=CPU, 99=todas (los overrides GPU ya lo fijan)
NGL=0

# Tipo de cache KV (q8_0 = -40% memoria, requiere flash attention)
KV_CACHE_TYPE=q8_0

# Prefill rápido
BATCH_SIZE=512
UBATCH_SIZE=512

# Decodificación especulativa (opcional, +25-60% tok/s): descarga también el
# draft y descomenta:  ./scripts/download-model.sh 0.6B Q8_0
# (el repo oficial Qwen3-0.6B-GGUF solo publica Q8_0, ~640 MB)
#DRAFT_MODEL=/models/Qwen3-0.6B-Q8_0.gguf

# Flags extra libres para llama-server (última palabra, pisa lo anterior)
#EXTRA_ARGS=

# ================================ API =========================================
# Tope de tokens por respuesta (por petición se puede sobrescribir)
MAX_TOKENS=512
TEMPERATURE=0.7
# Qwen3 sin fase "thinking": ahorra 1-3 s antes del primer token
ENABLE_THINKING=false

# === Memoria de conversación ===
# Mensajes activos máximos por sesión antes de disparar el resumen rodante,
# y cuántos se conservan sin resumir tras el rollup
HISTORY_MAX_MESSAGES=24
HISTORY_KEEP_MESSAGES=12
# Extraer hechos duraderos a la memoria de largo plazo tras cada turno.
# Cuesta una llamada LLM adicional por turno (enjaulada en segundo plano):
# déjalo en false si priorizas tokens/s al máximo.
FACT_EXTRACT=false

# === RAG ===
RAG_TOP_K=3
# Umbral de similitud, calibrado con potion-multilingual-128M sobre docs reales:
# relevantes ~0.42-0.75, ruido ~0.15-0.34. (Con un modelo e5: ~0.45-0.5.)
RAG_MIN_SCORE=0.40
# Modelo de embeddings (ONNX vía fastembed, se descarga solo la primera vez
# hacia ./data/fastembed; multilingüe, bueno en español, 256 dims).
# Alternativa: intfloat/multilingual-e5-large (2,2 GB, 1024 dims; la API le
# añade automáticamente sus prefijos "query:"/"passage:" obligatorios).
EMBED_MODEL=minishlab/potion-multilingual-128M
# Auto-ingesta de /corpus (docs del repo montadas en el contenedor) si el
# índice está vacío al arrancar
RAG_AUTOINGEST=true
# Espejo de HuggingFace si la red lo necesita (China): https://hf-mirror.com
#HF_ENDPOINT=https://hf-mirror.com
