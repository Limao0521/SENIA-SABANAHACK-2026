# Gemelo digital del X2 Ultra-N: la imagen del simulador oficial (ROS 2 Humble, librerías del MC) más lo que
# necesita nuestro MuJoCo como HAL: MuJoCo 3.15 (el del venv del host), OpenCV (JPEG de las cámaras),
# espeak-ng (TTS), utilidades de PulseAudio (altavoces y micrófono del PC) y PySide6 para la app de control
# (official_sim/twin.sh gui).
# numpy se queda en la rama 1.x: las extensiones de mensajes de ROS Humble están compiladas contra numpy 1.21.
ARG BASE_IMAGE=x2-ultra-sim:humble
FROM ${BASE_IMAGE}

RUN apt-get -o Acquire::Check-Date=false update && apt-get install -y --no-install-recommends \
      python3-pip \
      python3-opencv \
      espeak-ng \
      pulseaudio-utils \
      libpulse0 \
      libegl1 \
      libgles2 \
      libglvnd0 \
      libxcb-cursor0 libxkbcommon-x11-0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 \
      libxcb-xinerama0 libxcb-shape0 libxcb-randr0 libxcb-xfixes0 libxcb-sync1 libxcb-xkb1 libfontconfig1 \
      libdbus-1-3 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir "numpy==1.26.4" "mujoco==3.15.0" "PySide6==6.12.0"

ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV PYTHONPATH=/workspace/x2_ultra/src
ENV X2_URDF_ROOT=/workspace/agibot_x2_urdf
