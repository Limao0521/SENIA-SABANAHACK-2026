      "when_no": ["un 'no' dentro de una respuesta factual"],
      "examples_yes": ["Me prestas tu tarjeta de visita de recepcion?", "Puedo tomar fotos dentro del vestibulo?"],
      "examples_no": ["No, el laboratorio no esta a la izquierda, es a tu derecha (respuesta factual)"]
    },
    "NEGATION_STRONG": {
      "meaning": "negacion firme",
