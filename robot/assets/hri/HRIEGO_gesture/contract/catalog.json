      "examples_no": ["Puedes darme un caramelo?"]
    },
    "CONFIRMATION": {
      "meaning": "confirmar un hecho que el visitante pidio verificar",
      "when_yes": ["el visitante pregunta si algo es cierto y es verificable con los datos autorizados"],
      "when_no": ["informacion simple"],
      "examples_yes": ["Entonces el laboratorio es por ahi, verdad?"],
